# Required
TELEGRAM_BOT_TOKEN=123456789:ABC-your-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

# Optional: AI-written narrative overview (otherwise a rule-based one is used)
ANTHROPIC_API_KEY=

# Optional: keep watchlist/alert history across redeploys (needs a Railway volume at /data)
STATE_FILE=/data/state.json

# Filters (defaults shown)
MIN_MCAP=75000
MIN_LIQUIDITY=15000
WATCH_HOURS=24

# Rug-check standard (defaults shown)
RUG_MAX_SCORE=50
MAX_TOP10_PCT=30
MAX_SINGLE_HOLDER_PCT=10
MAX_INSIDER_PCT=10
MAX_CREATOR_PCT=5
MIN_HOLDERS=150
IGNORE_RISKS=

# Timing
SCAN_INTERVAL_SEC=60
RUG_RECHECK_MIN=10
DIGEST_HOURS=6
